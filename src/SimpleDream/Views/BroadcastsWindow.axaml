<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleDream.ViewModels"
        x:Class="SimpleDream.Views.BroadcastsWindow"
        x:DataType="vm:BroadcastsViewModel"
        Title="Broadcasts" Width="760" Height="560" MinWidth="560" MinHeight="320">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <Button Classes="seg" Classes.lit="{Binding FilterNow}" Content="On now" Command="{Binding SetFilterCommand}" CommandParameter="Now" />
        <Button Classes="seg" Classes.lit="{Binding FilterToday}" Content="Today" Command="{Binding SetFilterCommand}" CommandParameter="Today" />
        <Button Classes="seg" Classes.lit="{Binding FilterAll}" Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" />
      </StackPanel>
      <TextBox Grid.Column="1" Text="{Binding Search}" PlaceholderText="Search station, language, target or frequency" Margin="8,0" />
      <Button Grid.Column="2" Classes="flat" Content="Update" Command="{Binding UpdateCommand}" IsEnabled="{Binding !IsUpdating}" />
    </Grid>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock Text="{Binding SourceStatus}" Classes="label" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="label" Margin="8,0,0,0" />
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="64,74,112,*,90" Margin="10,0,10,4">
      <TextBlock Text="kHz" Classes="label" />
      <TextBlock Grid.Column="1" Text="Status" Classes="label" />
      <TextBlock Grid.Column="2" Text="Local time" Classes="label" ToolTip.Tip="{Binding TimeZoneName}" />
      <TextBlock Grid.Column="3" Text="Station" Classes="label" />
      <TextBlock Grid.Column="4" Text="Language" Classes="label" />
    </Grid>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BroadcastItem">
            <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding TuneCommand}"
                    ToolTip.Tip="{Binding Detail}">
              <Grid ColumnDefinitions="64,74,112,*,90">
                <TextBlock Text="{Binding KhzText}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="label" Classes.on="{Binding IsOn}" />
                <TextBlock Grid.Column="2" Text="{Binding LocalText}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="3">
                  <TextBlock Text="{Binding Station}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Target}" Classes="label" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding Language}" Classes="label" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
